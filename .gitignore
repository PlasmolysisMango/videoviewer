# Local secrets: the CLI reads credentials from the environment, never from the
# repository. Keep anything that looks like a session out of git.
account.txt
*.token
javdb.token
.env

# Android signing keys (use GitHub Secrets instead)
*.jks
*.keystore
**/key.properties

# Build output
/javdbcli
/javdbdump
/apiprobe
/tools/log-receiver/log-receiver
